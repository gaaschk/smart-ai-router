#!/usr/bin/env bash
# claudish-smart — point claudish at smart-ai-router's OpenAI-compatible proxy.
#
# Every request from Claude Code flows through POST /v1/chat/completions, which
# classifies the prompt and routes it to the best available model per call.
#
# Usage:
#   claudish-smart [claudish args...]
#
# Overrides:
#   SMART_ROUTER_URL=http://my-host:8001   change router address
#   SMART_ROUTER_API_KEY=<key>            API key for authenticated access
#   SMART_ROUTER_OPTIONAL=1               fall back to claudish defaults if unreachable

set -euo pipefail

ROUTER="${SMART_ROUTER_URL:-http://$(hostname):8001}"
API_KEY="${SMART_ROUTER_API_KEY:-}"
OPTIONAL="${SMART_ROUTER_OPTIONAL:-0}"

die() { echo "[claudish-smart] ERROR: $*" >&2; exit 1; }

# Build auth header for health check
_AUTH_HEADER=""
if [ -n "$API_KEY" ]; then
  _AUTH_HEADER="-H"
  _AUTH_HEADER2="Authorization: Bearer $API_KEY"
fi

# Check router reachability
if ! curl -sf --max-time 3 ${_AUTH_HEADER:+"$_AUTH_HEADER" "$_AUTH_HEADER2"} "$ROUTER/api/updates?fetch=false" > /dev/null 2>&1; then
  if [ "$OPTIONAL" = "1" ]; then
    echo "[claudish-smart] smart-ai-router unreachable at $ROUTER — using claudish defaults" >&2
    exec claudish "$@"
  else
    die "smart-ai-router unreachable at $ROUTER. Check the service is running, or set SMART_ROUTER_OPTIONAL=1 to fall back."
  fi
fi

echo "[claudish-smart] routing via $ROUTER/v1 (per-request classification)" >&2

# Point claudish's LiteLLM provider at the proxy.
# claudish sends OpenAI-format requests to LITELLM_BASE_URL/v1/chat/completions.
# The proxy classifies each prompt and forwards to the best model.
export LITELLM_BASE_URL="$ROUTER"
export LITELLM_API_KEY="${API_KEY:-smart-ai-router}"

# Override Bedrock config and name the routed models via project-level
# settings.local.json (higher priority than ~/.claude/settings.json). Drop exec
# so the EXIT trap fires for cleanup.
#
# Naming the models here rather than relying on claudish's --model-<role> flags
# is deliberate. claudish's proxy maps a request to a role by substring-matching
# the model name for "opus"/"sonnet"/"haiku", so it only works if Claude Code
# sends a recognizable Claude name. A ~/.claude/settings.json `modelOverrides`
# map (e.g. claude-opus-5 -> a Bedrock inference-profile ARN) rewrites the name
# first, so claudish sees the ARN, matches no role, finds no provider for it, and
# fails the request with "[Route] No credentialed providers in chain". Setting
# CLAUDE_CODE_USE_BEDROCK=0 doesn't help: it turns off the Bedrock transport but
# leaves the rewrite in place, and an empty "modelOverrides": {} here doesn't
# either, because settings merge key-wise so it can't clear inherited entries.
# ANTHROPIC_MODEL matches no override key, so it reaches the proxy verbatim.
_LOCAL_SETTINGS="$PWD/.claude/settings.local.json"
_LOCAL_SETTINGS_BACKUP=""

mkdir -p "$PWD/.claude"

_WROTE_SETTINGS=0

cleanup() {
  if [ -n "$_LOCAL_SETTINGS_BACKUP" ]; then
    mv "$_LOCAL_SETTINGS_BACKUP" "$_LOCAL_SETTINGS"
  elif [ "$_WROTE_SETTINGS" = "1" ]; then
    rm -f "$_LOCAL_SETTINGS"
    rmdir "$PWD/.claude" 2>/dev/null || true
  fi
}

# Arm the trap before touching anything, so an early exit can't leave a
# clobbered settings.local.json behind or orphan the backup in /tmp.
# The guards keep cleanup from deleting a file we never wrote.
trap cleanup EXIT

if [ -f "$_LOCAL_SETTINGS" ]; then
  _LOCAL_SETTINGS_BACKUP=$(mktemp)
  cp "$_LOCAL_SETTINGS" "$_LOCAL_SETTINGS_BACKUP"
fi

cat > "$_LOCAL_SETTINGS" <<'SETTINGS'
{
  "env": {
    "CLAUDE_CODE_USE_BEDROCK": "0",
    "ANTHROPIC_MODEL": "ll@smart-orchestrator",
    "ANTHROPIC_SMALL_FAST_MODEL": "ll@smart-orchestrator",
    "CLAUDE_CODE_SUBAGENT_MODEL": "ll@smart-worker"
  }
}
SETTINGS
_WROTE_SETTINGS=1

# The main Claude Code loop — recognizing skills, emitting Workflow/Agent tool
# calls — needs a Claude-compliant model, so ANTHROPIC_MODEL above sends it to
# 'smart-orchestrator', which restricts the proxy's candidates to Claude and then
# routes on the prompt within that pool (so a mechanical turn can still be cheap).
# Subagents do the fan-out work, so CLAUDE_CODE_SUBAGENT_MODEL sends them to
# 'smart-worker', which the proxy classifies and routes to the cheapest capable
# model (Claude fallback when nothing third-party clears the quality bar).
#
# The --model-<role> flags below no longer carry that split: claudish's proxy
# reads modelMap.opus/sonnet/haiku but never modelMap.subagent, so the subagent
# mapping was always inert. They stay for two reasons — claudish refuses to
# start without a model or role mapping, and they're the fallback for any
# request that still arrives under a Claude name (a hardcoded haiku call, or a
# session without the settings.local.json above).
claudish \
  --model-opus     "ll@smart-orchestrator" \
  --model-sonnet   "ll@smart-orchestrator" \
  --model-haiku    "ll@smart-orchestrator" \
  --model-subagent "ll@smart-worker" \
  "$@"
