# Backend Configuration
NODE_ENV=development
# 5000 collides with macOS AirPlay Receiver/ControlCenter on many Macs
PORT=5050
LOG_LEVEL=debug

# Database (Phase 4: multi-user support requires PostgreSQL)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dashboard

# Smart AI Router
SMART_ROUTER_URL=http://localhost:8001
SMART_ROUTER_API_KEY=

# GBrain
# GBrain has no HTTP API — the backend shells out to the `gbrain` CLI (must be
# on PATH, e.g. installed via `bun install -g github:garrytan/gbrain`).
GBRAIN_BIN=gbrain
# Only needed if GBrain is configured against Postgres instead of the default
# PGLite embedded database.
GBRAIN_DATABASE_URL=
GBRAIN_CLI_TIMEOUT_MS=30000

# Authentication
JWT_SECRET=your-secret-key-change-me
SESSION_TIMEOUT=3600000

# CORS
CORS_ORIGIN=http://localhost:5173

# WebSocket
WS_PING_INTERVAL=30000
WS_PING_TIMEOUT=5000
