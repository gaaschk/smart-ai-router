<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.smartrouter.api</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/python3</string>
		<string>-m</string>
		<string>smart_ai_router.cli.api</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/kevingaasch/ProjectHome/smart-ai-router</string>
	<key>StandardOutPath</key>
	<string>/var/log/smartrouter-api.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/smartrouter-api-error.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>OPENAI_API_KEY</key>
		<string>sk-YOUR_KEY_HERE</string>
		<key>ANTHROPIC_API_KEY</key>
		<string>sk-ant-YOUR_KEY_HERE</string>
		<key>GOOGLE_API_KEY</key>
		<string>AIzaSy_YOUR_KEY_HERE</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>5</integer>
	<key>ProcessType</key>
	<string>Adaptive</string>
</dict>
</plist>
